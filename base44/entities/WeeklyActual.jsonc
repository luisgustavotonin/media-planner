{
  "name": "WeeklyActual",
  "type": "object",
  "properties": {
    "plan_id": {
      "type": "string",
      "description": "Reference to MediaPlan"
    },
    "client_id": {
      "type": "string"
    },
    "reference_date": {
      "type": "string",
      "format": "date",
      "description": "Data de refer\u00eancia do realizado (at\u00e9 quando os n\u00fameros foram coletados)"
    },
    "week_number": {
      "type": "number",
      "description": "Legado: n\u00famero da semana. N\u00e3o usado no acompanhamento de resultados atual."
    },
    "week_start_date": {
      "type": "string",
      "format": "date",
      "description": "Legado: data de in\u00edcio da semana."
    },
    "investment_actual": {
      "type": "number",
      "description": "Legado: investimento realizado consolidado."
    },
    "kpi_actuals": {
      "type": "array",
      "description": "Legado: KPIs realizados consolidados.",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "number"
          }
        }
      }
    },
    "leads_actual": {
      "type": "number",
      "description": "Legado: leads reais"
    },
    "appointments_actual": {
      "type": "number"
    },
    "showups_actual": {
      "type": "number"
    },
    "channel_actuals": {
      "type": "array",
      "description": "Resultados realizados por canal. Cada item cont\u00e9m o investimento realizado e os valores reais por etapa do funil (stage_actuals).",
      "items": {
        "type": "object",
        "properties": {
          "channel_name": {
            "type": "string"
          },
          "investment": {
            "type": "number",
            "description": "Investimento realizado do canal"
          },
          "stage_actuals": {
            "type": "array",
            "description": "Valores realizados por etapa do funil (alinhado por label com o FunnelType)",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "value": {
                  "type": "number"
                }
              }
            }
          },
          "leads": {
            "type": "number",
            "description": "Legado: leads do canal"
          }
        }
      }
    }
  },
  "required": [
    "plan_id"
  ]
}