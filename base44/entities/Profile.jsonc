{
  "name": "Profile",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do perfil"
    },
    "level": {
      "type": "number",
      "description": "N\u00edvel hier\u00e1rquico (1=maior acesso)"
    },
    "description": {
      "type": "string"
    },
    "color": {
      "type": "string",
      "description": "Cor hex do perfil"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "inativo"
      ],
      "default": "ativo"
    },
    "permissions": {
      "type": "object",
      "description": "Mapa de permiss\u00f5es por m\u00f3dulo. Chave = key do m\u00f3dulo (ver src/lib/appModules.js). Valor = { view: boolean, use: boolean }. Permiss\u00f5es s\u00e3o din\u00e2micas: novos m\u00f3dulos do menu aparecem automaticamente.",
      "additionalProperties": true
    }
  },
  "required": [
    "name",
    "level"
  ]
}