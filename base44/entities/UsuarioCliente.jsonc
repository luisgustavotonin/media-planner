{
  "name": "UsuarioCliente",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio no Base44 (ou 'temp_'+email enquanto o convite n\u00e3o \u00e9 aceito)"
    },
    "user_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio (desnormalizado)"
    },
    "user_name": {
      "type": "string",
      "description": "Nome do usu\u00e1rio (desnormalizado)"
    },
    "client_id": {
      "type": "string",
      "description": "Refer\u00eancia ao Client (unidade)"
    },
    "profile_id": {
      "type": "string",
      "description": "Refer\u00eancia ao Profile (perfil de acesso)"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDENTE",
        "APROVADO",
        "INATIVO"
      ],
      "default": "PENDENTE",
      "description": "Status do v\u00ednculo"
    }
  },
  "required": [
    "user_id",
    "client_id"
  ]
}