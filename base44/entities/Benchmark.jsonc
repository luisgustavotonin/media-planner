{
  "name": "Benchmark",
  "type": "object",
  "properties": {
    "funnel_type_id": {
      "type": "string",
      "description": "Funil associado a este benchmark"
    },
    "funnel_type_name": {
      "type": "string",
      "description": "Nome do funil (desnormalizado)"
    },
    "channel_name": {
      "type": "string",
      "description": "Canal ao qual este benchmark se aplica (ex: Meta, Google, TikTok)"
    },
    "objective_id": {
      "type": "string",
      "description": "Objetivo de campanha ao qual este benchmark se aplica"
    },
    "objective_name": {
      "type": "string",
      "description": "Nome do objetivo (desnormalizado)"
    },
    "segment": {
      "type": "string",
      "description": "Chave interna do segmento (especialidade do cliente)"
    },
    "segment_label": {
      "type": "string",
      "description": "Nome exibido do segmento"
    },
    "conversion_rates": {
      "type": "array",
      "description": "Taxas de convers\u00e3o din\u00e2micas por etapa do funil (0-1)",
      "items": {
        "type": "number"
      }
    },
    "default_cpl": {
      "type": "number",
      "description": "CPL padr\u00e3o para este canal/objetivo/segmento (R$)"
    },
    "default_cpm": {
      "type": "number",
      "description": "CPM padr\u00e3o para campanhas de awareness (R$)"
    },
    "default_cpc": {
      "type": "number",
      "description": "CPC padr\u00e3o para campanhas de tr\u00e1fego (R$)"
    },
    "default_ctr": {
      "type": "number",
      "description": "CTR padr\u00e3o esperado (0-1)"
    },
    "lead_to_appointment_rate": {
      "type": "number",
      "description": "Legacy: Lead \u2192 Agendamento (0-1)"
    },
    "appointment_to_show_rate": {
      "type": "number",
      "description": "Legacy: Agendamento \u2192 Comparecimento (0-1)"
    },
    "show_to_sale_rate": {
      "type": "number",
      "description": "Legacy: Comparecimento \u2192 Venda (0-1)"
    },
    "meta_default_cpl": {
      "type": "number",
      "description": "Legacy: CPL padr\u00e3o Meta (R$) \u2014 use default_cpl"
    },
    "google_default_cpl": {
      "type": "number",
      "description": "Legacy: CPL padr\u00e3o Google (R$) \u2014 use default_cpl"
    }
  },
  "required": [
    "funnel_type_id",
    "channel_name",
    "objective_id",
    "segment_label"
  ]
}