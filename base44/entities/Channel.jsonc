{
  "name": "Channel",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do canal (ex: Meta, Google, TikTok)"
    },
    "description": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es do canal \u2014 o que \u00e9 este canal (ex: indica\u00e7\u00f5es ativa e passiva, pacientes inativos da base)"
    },
    "category": {
      "type": "string",
      "enum": [
        "digital",
        "offline"
      ],
      "default": "digital",
      "description": "Grupo do canal: digital (online) ou offline (m\u00eddia tradicional)"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name"
  ]
}